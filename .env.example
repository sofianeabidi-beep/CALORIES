# Projet Supabase — région UE obligatoire (données de santé, RGPD).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Serveur uniquement. Ne jamais préfixer NEXT_PUBLIC_, ne jamais
# importer depuis un composant client. Contourne la RLS.
SUPABASE_SERVICE_ROLE_KEY=

# URL publique du site, utilisée pour les redirections d'authentification.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Protège la route d'entretien planifiée (phase 3).
CRON_SECRET=

# Open Food Facts exige un User-Agent identifiant l'application.
# Format attendu : Caloryes/0.1 (contact@exemple.fr)  — phase 2.
OFF_USER_AGENT=
