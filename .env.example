# Projet Supabase — région UE obligatoire (données de santé, RGPD).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Serveur uniquement. Ne jamais préfixer NEXT_PUBLIC_, ne jamais
# importer depuis un composant client. Contourne la RLS.
SUPABASE_SERVICE_ROLE_KEY=

# URL publique du site, utilisée pour les redirections d'authentification.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Protège les routes planifiées (cron Vercel, voir vercel.json) : Vercel
# envoie automatiquement `Authorization: Bearer $CRON_SECRET` pour les
# tâches qu'il déclenche lui-même. Une valeur au hasard suffit.
CRON_SECRET=

# Rapport hebdomadaire par mail (chaque lundi, voir vercel.json).
# Clé au format re_... depuis resend.com — compte et domaine d'envoi à
# créer soi-même, aucun outil ne peut le faire à la place de
# l'utilisateur. Sans domaine vérifié, repli automatique sur l'adresse
# de test fournie par Resend (onboarding@resend.dev).
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Open Food Facts exige un User-Agent identifiant l'application.
# Format attendu : Caloryes/0.1 (contact@exemple.fr)  — phase 2.
OFF_USER_AGENT=

# Estimation nutritionnelle par IA d'un plat décrit en texte libre
# (dernier recours, pour ce qu'aucune base de données ne référence).
# Serveur uniquement. Clé au format sk-ant-... depuis console.anthropic.com.
ANTHROPIC_API_KEY=
